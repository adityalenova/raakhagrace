import { X } from "lucide-react";
import { useEffect, useState } from "react";
import { LotusMark } from "./LotusMark";

type Phase = "intro" | "welcome" | "done";

function readPhase(): Phase {
  if (typeof window === "undefined") return "done";
  if (sessionStorage.getItem("rg-welcome")) return "done";
  if (sessionStorage.getItem("rg-intro")) return "welcome";
  return "intro";
}

export function LaunchFlow() {
  const [phase, setPhase] = useState<Phase>("intro");

  useEffect(() => {
    setPhase(readPhase());
  }, []);

  useEffect(() => {
    if (phase !== "intro") return;
    const t = window.setTimeout(() => {
      sessionStorage.setItem("rg-intro", "1");
      setPhase("welcome");
    }, 2800);
    return () => window.clearTimeout(t);
  }, [phase]);

  function finishWelcome() {
    sessionStorage.setItem("rg-intro", "1");
    sessionStorage.setItem("rg-welcome", "1");
    setPhase("done");
  }

  if (phase === "done") return null;

  if (phase === "intro") {
    return (
      <div
        className="fixed inset-0 z-[80] grid place-items-center bg-bg px-6 text-center"
        onClick={() => {
          sessionStorage.setItem("rg-intro", "1");
          setPhase("welcome");
        }}
      >
        <div className="fade-up pointer-events-none">
          <LotusMark className="mx-auto h-14 w-14" />
          <p className="mt-6 font-display text-2xl tracking-[0.2em]">RAAKHA GRACE</p>
          <p className="mt-3 text-[0.7rem] tracking-[0.35em] text-subtle uppercase">The atelier is opening</p>
          <p className="mx-auto mt-8 max-w-md font-display text-2xl italic leading-snug text-fg sm:text-3xl">
            “Jewelry has the power to be the one little thing that makes you feel unique.”
          </p>
        </div>
      </div>
    );
  }

  return (
    <div className="fixed inset-0 z-[80] grid place-items-center bg-fg/45 px-4">
      <div className="relative w-full max-w-md rounded-xl bg-surface p-8 text-center shadow-xl">
        <button
          type="button"
          className="absolute right-3 top-3 grid h-11 w-11 place-items-center text-muted"
          aria-label="Close welcome"
          onClick={finishWelcome}
        >
          <X className="h-5 w-5" />
        </button>
        <LotusMark className="mx-auto h-10 w-10 text-fg" />
        <h2 className="mt-4 font-display text-3xl">Welcome to Raakha Grace</h2>
        <p className="mt-3 text-sm leading-relaxed text-muted">
          Handmade jewellery, light on the skin and meant for every occasion. Enjoy complimentary gift wrapping on your first
          order.
        </p>
        <button
          type="button"
          className="mt-6 h-12 w-full rounded-md bg-fg text-sm tracking-[0.16em] text-bg uppercase"
          onClick={finishWelcome}
        >
          Begin exploring
        </button>
      </div>
    </div>
  );
}

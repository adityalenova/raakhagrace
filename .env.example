# ── Raakha Grace — environment ───────────────────────────────────────────────
# Copy to .env for local work; on Vercel set each one under
# Project → Settings → Environment Variables (Production + Preview).
# Empty values are treated as "not set", so the app degrades instead of crashing.

# ── Google sign-in (Google Cloud Console → APIs & Services → Credentials) ────
# Create an "OAuth client ID" of type Web application.
# Authorized redirect URIs — add BOTH, with your real Vercel host:
#   https://<your-project>.vercel.app/api/auth/callback/google
#   http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session signing + public origin ─────────────────────────────────────────
# Random secret, min 32 chars:  openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public origin of the deployed app. Optional on Vercel — the production URL is
# detected automatically; set it explicitly for a custom domain.
BETTER_AUTH_URL=

# ── Database (sessions, users, accounts) ────────────────────────────────────
# Required for real sign-in on Vercel: the embedded PGLite fallback cannot
# persist across serverless cold starts. Vercel Postgres / Neon both work.
# Migrations run automatically during `npm run build`.
DATABASE_URL=

# ── Admin allowlist (/admin) ────────────────────────────────────────────────
# Comma-separated Google addresses allowed to open the product admin.
ADMIN_EMAILS=

# ── Order enquiry email (Resend → resend.com/api-keys) ──────────────────────
# RESEND_FROM must use a sender/domain verified in Resend.
RESEND_API_KEY=
RESEND_FROM=
ORDER_NOTIFY_EMAIL=

# ── Grace AI product stylist (console.x.ai) ─────────────────────────────────
XAI_API_KEY=

# ── Master switches ─────────────────────────────────────────────────────────
# Set to false for a UI-only deploy with no sign-in at all. Unset = on.
VITE_AUTH_ENABLED=

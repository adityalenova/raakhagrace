# ── Raakha Grace — environment ───────────────────────────────────────────────
# Copy to .env for local work; on Vercel set each one under
# Project → Settings → Environment Variables (Production + Preview).
# Empty values are treated as "not set", so the app degrades instead of crashing.

# ── Google sign-in (Google Cloud Console → APIs & Services → Credentials) ────
# Create an "OAuth client ID" of type Web application.
# Authorized redirect URIs — add BOTH, with your real Vercel host:
#   https://<your-project>.vercel.app/api/auth/callback/google
#   http://localhost:8080/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Session signing + public origin ─────────────────────────────────────────
# Random secret, min 32 chars:  openssl rand -hex 32
BETTER_AUTH_SECRET=
# Public origin of the deployed app. Optional on Vercel — the production URL is
# detected automatically; set it explicitly for a custom domain.
BETTER_AUTH_URL=

# ── Database (sessions, users, accounts) ────────────────────────────────────
# Required for real sign-in on Vercel: the embedded PGLite fallback cannot
# persist across serverless cold starts. Vercel Postgres / Neon both work.
# Migrations run automatically during `npm run build`.
DATABASE_URL=

# ── Admin allowlist (/admin) ────────────────────────────────────────────────
# Comma-separated Google addresses allowed to open the product admin.
ADMIN_EMAILS=

# ── Order enquiry email (Resend → resend.com/api-keys) ──────────────────────
# RESEND_FROM must use a sender/domain verified in Resend.
#
# Confirmed against this project's key: while RESEND_FROM is Resend's shared
# `onboarding@resend.dev` sandbox address, the API answers 200 for the address
# the Resend account was created with and 422 for everyone else. So order
# notifications to the atelier inbox work, and customer mail — verification
# links, welcome notes — is refused. Fix is a verified domain in Resend, which
# needs a registered domain and its DNS. `node scripts/check-resend.mjs` probes
# it; pass an address to test a specific recipient.
RESEND_API_KEY=
RESEND_FROM=
ORDER_NOTIFY_EMAIL=

# ── Cloudflare Turnstile (dash.cloudflare.com → Turnstile) ──────────────────
# Proves the email sign-in form is a person and not a script filling it. Both
# halves are needed and they live on different sides of the wire:
#   VITE_TURNSTILE_SITE_KEY  → the browser widget (public, ships in the bundle)
#   TURNSTILE_SECRET_KEY     → server-side verification (secret, never exposed)
# The widget is hidden and the form unchecked until BOTH are set, so leaving
# these empty is safe — it is not a half-on state.
# Do not put Cloudflare's `1x…`/`2x…` test pairs in Production: those skip the
# check entirely, and the always-pass one is accepted for any token.
VITE_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Grace AI product stylist (console.x.ai) ─────────────────────────────────
XAI_API_KEY=

# ── Master switches ─────────────────────────────────────────────────────────
# Set to false for a UI-only deploy with no sign-in at all. Unset = on.
VITE_AUTH_ENABLED=

# Gate `/dashboard` on a confirmed email address. Unset = off, which is the
# safe default while customer mail is still going through Resend's sandbox
# sender: with it on, an email/password account cannot receive the link that
# would open its own dashboard. Google accounts verify at the provider and are
# unaffected either way. See src/lib/auth/verify-gate.ts.
VITE_REQUIRE_EMAIL_VERIFICATION=
